# Neon Postgres connection string (use the POOLED connection string from Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Gemini API key — https://aistudio.google.com/apikey (free tier). Optional: when
# set, the free Gemini models lead the voice agent's fallback chain (and fall
# back to Groq when their daily quota is spent). Leave blank to use Groq only.
GEMINI_API_KEY=""

# Your timezone, used so the assistant resolves "tomorrow 7pm" correctly
ASSISTANT_TIMEZONE="Asia/Singapore"

# ───────────────────────── MailMind (embedded email-summarizer) ─────────────────────────
# Shared secret the dashboard prompts for and sends as a Bearer token.
DASHBOARD_SECRET="choose-a-long-random-string"

# Public base URL of this app (used in notification links). No trailing slash.
SITE_URL="https://your-app.vercel.app"

# Google OAuth (Gmail read-only). Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must EXACTLY match an Authorized redirect URI in Google Cloud Console:
GOOGLE_REDIRECT_URI="https://your-app.vercel.app/api/mail/auth-callback"

# Twilio WhatsApp sender (only if you enable WhatsApp alerts), e.g. +14155238886
TWILIO_WHATSAPP_FROM=""

# ───────────────────── Free messaging (voice agent → people) ─────────────────────
# Send messages to people for free (no Twilio). Three channels:
#  • Telegram (bot) — reuses the MailMind bot token if set; otherwise put it here.
#    The recipient must message your bot once so you have their numeric chat id.
TELEGRAM_BOT_TOKEN=""
#  • Telegram (your account, preferred) — message any contact as yourself AND
#    import your Telegram contact list. Get api_id/api_hash free at
#    https://my.telegram.org, then run `npm run telegram:login` to fill the session.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_STRING_SESSION=""
#  • Email — Gmail SMTP via an App Password (https://myaccount.google.com/apppasswords).
#    Use the sending Gmail address and the 16-char app password (spaces are fine).
GMAIL_SEND_USER=""
GMAIL_APP_PASSWORD=""
#  • WhatsApp — opened by the local bridge with the message pre-filled. By default
#    the bridge auto-presses Enter to send; set to 0 to only pre-fill (you hit send).
WHATSAPP_AUTO_SEND="1"

# Optional: if set, Vercel cron requests must carry this as a Bearer token.
CRON_SECRET=""

# ───────────────────────── Spotify (real playback, Premium) ─────────────────────────
# Create an app at https://developer.spotify.com/dashboard, then add BOTH redirect
# URIs below to the app's settings. Connect once by visiting /api/spotify/login.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
# Must EXACTLY match a Redirect URI in the Spotify app settings.
# Local dev: http://127.0.0.1:3000/api/spotify/callback
# Production: https://your-app.vercel.app/api/spotify/callback
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/spotify/callback"

# --- Built-in rotating /v1 LLM proxy ---
# The proxy at /v1/chat/completions rotates the free-tier keys in the LLM Keys
# tab. It's public on Vercel, so set a secret here and send it as
# `Authorization: Bearer <LLM_PROXY_KEY>`. Leave empty in local dev to allow
# unauthenticated calls.
LLM_PROXY_KEY=""
