# Neon Postgres connection string (use the POOLED connection string from Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Your timezone, used so the assistant resolves "tomorrow 7pm" correctly
ASSISTANT_TIMEZONE="Asia/Singapore"
