{
  "name": "personal-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "bridge": "node scripts/bridge/server.mjs",
    "bridge:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bridge/install-autostart.ps1",
    "bridge:autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bridge/uninstall-autostart.ps1",
    "bridge:browser-install": "playwright install chromium",
    "telegram:login": "node scripts/telegram-login.mjs",
    "models:check": "node scripts/check-models.mjs",
    "desktop:check": "node scripts/check-desktop-electron.mjs",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@neondatabase/serverless": "^0.10.4",
    "@netlify/functions": "^5.3.0",
    "@remotion/player": "^4.0.474",
    "@types/qrcode": "^1.5.6",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.36.4",
    "googleapis": "^140.0.1",
    "groq-sdk": "^0.9.1",
    "mammoth": "^1.12.0",
    "next": "^14.2.33",
    "nodemailer": "^6.10.1",
    "onnxruntime-web": "^1.20.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.474",
    "telegram": "^2.26.22",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.1",
