/**\n   * Get Platform specific route state to laod\n   * @param platform\n   */\n  getPlatformSpecificRoute(platform: TargetedDisplay): AppRouter {\n    return TargetedDisplay.Mobile === platform\n      ? AppRouter.QuestionSectionRoute\n      : AppRouter.FeedbackSectionRoute;\n  }\n\n  getSentimentState(serviceType: ServiceType, trackingId: string | undefined): AppRouter {\n    const configuration = appStore.get('configuration');\n    const { isEnabled } = this.bugReportService.GetBRTConfig(\n      serviceType,\n      this.ongoingServices.getActiveTrackingId(),\n    ) as BugReportForm;\n\n    if (serviceType === ServiceType.InformationalService) {\n      return Utils.getStateForInformationalService(\n        this.isEnableForIs,\n        this.behaviorService.isServiceCompleted('app'),\n        configuration,\n        isEnabled,\n      );\n    }\n\n    // Service Type Transactional Service\n    if (trackingId === undefined) {\n      if (!isEnabled) {\n        return configuration?.defaultState!!;\n      }\n      return AppRouter.DisplayNoneRoute;\n    }\n    const transactionalService = this.transactionalServices.get(trackingId);\n    const isInSession = this.behaviorService.isServiceCompleted(trackingId);\n    const ongoingService = this.ongoingServices.getService(trackingId);\n    return Utils.getStateForTransactionalService(\n      transactionalService,\n      configuration,\n      {\n        isInSession,\n        platform: this.platform,\n        isRatingSubmitted: ongoingService.rs,\n        isCompleted: ongoingService.ic,\n      },\n      isEnabled,\n    );\n  }\n\n  private clearSessionVariables(serviceType: ServiceType) {\n    if (serviceType === ServiceType.TransactionalService) {\n      if (this.ongoingServices.getNumberOfServices() === 0) {\n        appStore.set('serviceType', ServiceType.InformationalService);\n      }\n      Logger.log('removed tracking id from session');\n    }\n  }\n\n  /**\n   * Complete Transactional Service\n   * @param tsOpts Trans