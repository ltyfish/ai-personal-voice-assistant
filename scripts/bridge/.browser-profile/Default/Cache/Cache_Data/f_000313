{"version":3,"file":"p-Dz0HTRDS.js","sources":["src/services/CoreService.ts","src/services/BugReportService.ts"],"sourcesContent":["export class CoreService {\n  private readonly SentimentsIdName = 'sentiments.sentimentsId';\n  private readonly CollapsedModeName = 'sentiments.switchCollapsedMode';\n  private sentimentsId: string;\n  private collapsedMode: boolean;\n  private shouldTrackBugReportFormEntry: boolean = true;\n\n  constructor() {\n    const id = window.sessionStorage.getItem(this.SentimentsIdName);\n    const status = window.sessionStorage.getItem(this.CollapsedModeName);\n    if (id) {\n      this.sentimentsId = id;\n    }\n\n    if (status) {\n      this.collapsedMode = status === 'true';\n    }\n  }\n\n  setSentimentsId(id: string): void {\n    this.sentimentsId = id;\n    window.sessionStorage.setItem(this.SentimentsIdName, id);\n\n    // mark it as new session after sentimentsId is generated.\n    this.shouldTrackBugReportFormEntry = true;\n  }\n\n  getSentimentsId(): string {\n    return this.sentimentsId;\n  }\n\n  setCollapsedMode(status: boolean): void {\n    this.collapsedMode = status;\n    window.sessionStorage.setItem(this.CollapsedModeName, status.toString());\n  }\n\n  getCollapsedMode(): boolean {\n    return this.collapsedMode;\n  }\n\n  hasBugReportFormEntryTracked(): boolean {\n    return this.shouldTrackBugReportFormEntry;\n  }\n\n  disableBugReportFormEntryTracking(): void {\n    this.shouldTrackBugReportFormEntry = false;\n  }\n}\n","import { BugReportFormMetadata } from '@actions/WogaaLayerActions';\nimport { EnvConfigs } from '@environment/resources';\nimport { Logger } from './Logger';\nimport appStore from '@stores/app.store';\nimport { ServiceType } from '@entities/ServiceType';\n\nexport class BugReportService {\n  private http: typeof fetch;\n  private currentController = {} as AbortController;\n  private Bug_Report_Name: string;\n  constructor() {\n    this.http = async (url, options: RequestInit = {}) => {\n      // Cancel any ongoing request\n      if (Object.keys(this.currentController).length) {\n        this.currentController.abort();\n      }\n\n      // Create a new controller for this request\n      const controller = new AbortController();\n      this.currentController = controller;\n\n      try {\n        const response = await fetch(url, { ...options, signal: controller.signal });\n\n        if (!response.ok) {\n          throw new Error(`HTTP ${response.status}`)\n        };\n\n        const data = await response.json();\n        this.currentController = {} as AbortController;\n        return data;\n      } catch (error: any) {\n        this.currentController = {} as AbortController;\n\n        if (error.name === 'AbortError') {\n          Logger.log(`Error while requesting in ${url}`, error);\n          throw new Error(`Error while processing request`);\n        }\n        Logger.log('Network error:', error);\n        throw new Error('Network error');\n      }\n    };\n\n    this.Bug_Report_Name = 'sentiments-bug-report';\n  }\n\n  private resetBugReportId() {\n    window.sessionStorage.removeItem(this.Bug_Report_Name);\n  }\n\n  private setBugReportId(bugId: string) {\n    window.sessionStorage.setItem(this.Bug_Report_Name, bugId);\n  }\n\n  private getBugReportId() {\n    return window.sessionStorage.getItem(this.Bug_Report_Name);\n  }\n\n  private getUrl(path: string, searchParams?: Record<string, any>): string {\n    const search = new URLSearchParams(searchParams);\n    const paths = [EnvConfigs.SentimentsEndpoint, path].join('/');\n    const url = new URL(paths);\n    url.search = search.toString();\n    return url.toString();\n  }\n\n  private getBrowserInfo() {\n    const ua = navigator.userAgent;\n    let browser = 'Unknown';\n    let version = 'Unknown';\n\n    const match = (regex: RegExp) => ua.match(regex);\n\n    if (match(/GSA\\/([\\d.]+)/)) {\n      browser = 'Google App';\n      version = (match(/GSA\\/([\\d.]+)/) as RegExpMatchArray)[1];\n    }\n    else if (match(/OPR\\/([\\d.]+)/)) {\n      browser = 'Opera';\n      version = (match(/OPR\\/([\\d.]+)/) as RegExpMatchArray)[1];\n    } else if (match(/Edg\\/([\\d.]+)/)) {\n      browser = 'Edge';\n      version = (match(/Edg\\/([\\d.]+)/) as RegExpMatchArray)[1];\n    } else if (match(/Chrome\\/([\\d.]+)/)) {\n      browser = 'Chrome';\n      version = (match(/Chrome\\/([\\d.]+)/) as RegExpMatchArray)[1];\n    } else if (match(/Firefox\\/([\\d.]+)/)) {\n      browser = 'Firefox';\n      version = (match(/Firefox\\/([\\d.]+)/) as RegExpMatchArray)[1];\n    } else if (match(/Version\\/(\\d+(\\.\\d+)?).*Safari/)) {\n      browser = 'Safari';\n      version = (match(/Version\\/([\\d.]+).*Safari/) as RegExpMatchArray)[1];\n    } else if (match(/SamsungBrowser\\/([\\d.]+)/)) {\n      browser = 'Samsung Internet';\n      version = (match(/SamsungBrowser\\/([\\d.]+)/) as RegExpMatchArray)![1];\n    } else if (match(/CriOS\\/([\\d.]+)/)) {\n      browser = 'Chrome (iOS)';\n      version = (match(/CriOS\\/([\\d.]+)/) as RegExpMatchArray)![1];\n    }\n\n    return `${browser}-${version}`;\n  }\n  private getClientContext() {\n    const ua = navigator.userAgent;\n\n    // browser\n    let browser = this.getBrowserInfo();\n\n    // OS\n    let osDevice = 'Unknown';\n    if (ua.includes('Windows')) osDevice = 'Windows';\n    else if (ua.includes('Mac OS')) osDevice = 'Mac OS';\n    else if (ua.includes('Android')) osDevice = 'Android';\n    else if (ua.includes('iPhone') || ua.includes('iPad')) osDevice = 'iOS';\n    else if (ua.includes('Linux')) osDevice = 'Linux';\n\n    // device type\n    let deviceType = 'desktop';\n    if (/Mobi|Android/i.test(ua)) deviceType = 'mobile';\n    if (/Tablet|iPad/i.test(ua)) deviceType = 'tablet';\n\n    // full URL\n    const serviceUrl = window.location.href;\n\n    return {\n      serviceUrl,\n      browser,\n      osDevice,\n      deviceType,\n    };\n  }\n\n  // Convert Base64 key to CryptoKey\n  private async importKey() {\n    const base64Key = EnvConfigs.BrtSecurityKey;\n    const rawKey = Uint8Array.from(atob(base64Key), c => c.charCodeAt(0));\n    return window.crypto.subtle.importKey(\n      'raw',\n      rawKey,\n      { name: EnvConfigs.BrtSecurityAlgorithm },\n      false, // extractable\n      ['encrypt', 'decrypt'],\n    );\n  }\n\n  // Encrypt a string\n  private async encrypt(plainText: string) {\n    const key = await this.importKey();\n    const encoder = new TextEncoder();\n    const data = encoder.encode(plainText);\n\n    // Generate a random 12-byte IV (recommended for GCM)\n    const iv = window.crypto.getRandomValues(new Uint8Array(12));\n\n    const ciphertext = await window.crypto.subtle.encrypt(\n      {\n        name: EnvConfigs.BrtSecurityAlgorithm,\n        iv: iv,\n      },\n      key,\n      data,\n    );\n\n    // Return IV + ciphertext concatenated and Base64-encoded\n    const combined = new Uint8Array(iv.length + ciphertext.byteLength);\n    combined.set(iv);\n    combined.set(new Uint8Array(ciphertext), iv.length);\n\n    return btoa(String.fromCharCode(...combined));\n  }\n\n  private async decrypt(encryptedBase64: string): Promise<string> {\n    const key = await this.importKey();\n    const combined = Uint8Array.from(atob(encryptedBase64), c => c.charCodeAt(0));\n\n    const iv = combined.slice(0, 12);\n    const ciphertext = combined.slice(12, -16); // last 16 bytes are auth tag\n    const authTag = combined.slice(-16);\n\n    const decrypted = await window.crypto.subtle.decrypt(\n      {\n        name: EnvConfigs.BrtSecurityAlgorithm,\n        iv: iv,\n        tagLength: 128, // 16 bytes\n      },\n      key,\n      // The Web Crypto API expects ciphertext + authTag concatenated\n      (() => {\n        const concat = new Uint8Array(ciphertext.length + authTag.length);\n        concat.set(ciphertext);\n        concat.set(authTag, ciphertext.length);\n        return concat;\n      })(),\n    );\n\n    const decoder = new TextDecoder();\n    return decoder.decode(decrypted);\n  }\n\n  /**\n   * get brt config\n   * @param serviceType\n   * @param trackingId\n   * @returns\n   */\n  GetBRTConfig(serviceType: ServiceType, trackingId?: string) {\n    const configuration = appStore.get('configuration');\n    if (configuration) {\n      const { bugReportTool } = configuration;\n      if (!bugReportTool) {\n        return { isEnabled: false };\n      }\n\n      const brtConfig =\n        serviceType === ServiceType.InformationalService\n          ? configuration?.bugReportTool.informationalService\n          : configuration?.bugReportTool.transactionalServices.filter(\n              e => e.trackingId === trackingId,\n            )[0];\n      return brtConfig ? brtConfig : { isEnabled: false };\n    }\n    return { isEnabled: false };\n  }\n\n  /**\n   * equest to sentiments backend to get pre-sign url for uploading.\n   *\n   * @param sentimentsId\n   * @param imageType\n   * @returns\n   */\n  async RequestPreSignedURL(\n    rsid: string,\n    sentimentsId: string,\n    imageType: string,\n  ): Promise<Record<string, string>> {\n    try {\n      const url = this.getUrl(`public/v1/brt/response/${rsid}/upload-url`, {\n        transactionId: sentimentsId,\n        contentType: imageType,\n      });\n      const response = await this.http(url, { method: 'GET' });\n\n      const decryptedData = JSON.parse(await this.decrypt((response as any).data));\n\n      this.setBugReportId(decryptedData?.bugId);\n\n      return decryptedData;\n    } catch (error) {\n      Logger.log('error while requesting S3 presigned url', { error });\n      throw new Error('error while requesting S3 presigned url');\n    }\n  }\n\n  /**\n   * upload image to S3 storage via pre-sign url.\n   *\n   * @param preSignedUrl\n   * @param file\n   * @returns\n   */\n  async UploadImage(preSignedUrl: string, file: Blob | null, imageType: string): Promise<void> {\n    try {\n      const data = await fetch(preSignedUrl, {\n        method: 'PUT',\n        headers: {\n          'Content-Type': imageType,\n        },\n        body: file,\n      });\n\n      if (!data.ok) {\n        Logger.log('Failture while uploading image to S3', { preSignedUrl });\n        throw new Error('error while uploading image to S3');\n      }\n\n      return;\n    } catch (error) {\n      Logger.log('error while uploading image to S3', { error });\n      throw new Error('error while uploading image to S3');\n    }\n  }\n\n  /**\n   * bug report form submission.\n   * @param payload\n   */\n  async SubmitBugReportForm(payload: BugReportFormMetadata) {\n    try {\n      const data = {\n        ...payload,\n        ...this.getClientContext(),\n        bugId: this.getBugReportId() || '',\n        requestedAt: new Date(),\n      };\n\n      const url = this.getUrl('public/v1/brt/response');\n      await fetch(url, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n        },\n        body: JSON.stringify({ data: await this.encrypt(JSON.stringify(data)) }),\n      });\n\n      this.resetBugReportId();\n    } catch (error) {\n      Logger.log('error while submitting bug report form', { error });\n    }\n  }\n}\n"],"names":["appStore"],"mappings":";;;MAAa,WAAW,CAAA;AAOtB,IAAA,WAAA,GAAA;QANiB,IAAgB,CAAA,gBAAA,GAAG,yBAAyB;QAC5C,IAAiB,CAAA,iBAAA,GAAG,gCAAgC;QAG7D,IAA6B,CAAA,6BAAA,GAAY,IAAI;AAGnD,QAAA,MAAM,EAAE,GAAG,MAAM,CAAC,cAAc,CAAC,OAAO,CAAC,IAAI,CAAC,gBAAgB,CAAC;AAC/D,QAAA,MAAM,MAAM,GAAG,MAAM,CAAC,cAAc,CAAC,OAAO,CAAC,IAAI,CAAC,iBAAiB,CAAC;QACpE,IAAI,EAAE,EAAE;AACN,YAAA,IAAI,CAAC,YAAY,GAAG,EAAE;;QAGxB,IAAI,MAAM,EAAE;AACV,YAAA,IAAI,CAAC,aAAa,GAAG,MAAM,KAAK,MAAM;;;AAI1C,IAAA,eAAe,CAAC,EAAU,EAAA;AACxB,QAAA,IAAI,CAAC,YAAY,GAAG,EAAE;QACtB,MAAM,CAAC,cAAc,CAAC,OAAO,CAAC,IAAI,CAAC,gBAAgB,EAAE,EAAE,CAAC;;AAGxD,QAAA,IAAI,CAAC,6BAA6B,GAAG,IAAI;;IAG3C,eAAe,GAAA;QACb,OAAO,IAAI,CAAC,YAAY;;AAG1B,IAAA,gBAAgB,CAAC,MAAe,EAAA;AAC9B,QAAA,IAAI,CAAC,aAAa,GAAG,MAAM;AAC3B,QAAA,MAAM,CAAC,cAAc,CAAC,OAAO,CAAC,IAAI,CAAC,iBAAiB,EAAE,MAAM,CAAC,QAAQ,E