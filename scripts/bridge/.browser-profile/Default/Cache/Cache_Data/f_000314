{"version":3,"names":["BugReportForm","constructor","hostRef","this","isValid","registry","requiredQuestions","preparedQuestions","trap","createFocusTrap","trapActivate","active","activate","trapDeactivate","deactivate","handleCancel","bugReportFormCancel","emit","handleValidStatusChange","event","status","responses","detail","filter","r","questionType","QuestionType","DefaultAcknowledgeQuestion","handleSubmit","preventDefault","values","map","index","questionId","label","value","questionNumber","response","bugReportFormSubmit","handleKeyDown","ev","key","componentWillLoad","questions","sort","a","b","q","length","push","id","Math","floor","random","isRequired","getRegistry","componentDidLoad","bugReportFormContainer","allowOutsideClick","clickOutsideDeactivates","escapeDeactivates","initialFocus","fallbackFocus","onPostActivate","document","body","focus","bugReportFormEntry","question","ValidateStatus","None","render","rootClass","position","WidgetPosition","MiddleLeft","MiddleRight","BottomLeft","BottomRight","submitButtonCx","backgroundStyles","backgroundColor","design","Design","SmileyFace","themeColor","textStyles","color","appearance","Appearance","Light","fontWeight","formStyles","width","minWidth","minHeight","h","class","ref","el","tabIndex","role","isWhite","onClose","style","novalidate","name","onSubmit","e","onValidStatusChange","type","disabled","Object","assign","onClick","SatisfactionState","RatingCES","satisfactionState","Rating","isFeedbackButtonActive","cesQuestion","onFeedbackSubmit","Responded","ratedValue","parseInt","ratingCESSubmit","ratingSubmitAnimationComplete","onRatingClose","ratingClose","setTimeout","ratingContainer","ratingDummyContainer","renderSvg","fill","viewBox","xmlns","d","renderRatingField","config","ratingScaleDesign","RatingScaleDesign","Numerical","highScale","lowScale","isDisabled","onValueSubmit","customTabIndex","Emoji","Star","renderConditionalView","viewState","ratingQuestion","containerClasses","ratingFieldClasses","customAriaLabel","configuration","appStore","get","elementClasses","ConnectionError","isLoading","handleRatingClose","connectWindowClose","handleTryAgain","fetchData","trackingId","submitButtonStyle","cx","cy","stroke","FeaturesForm","ongoingServices","OngoingTransactionalService","handleKeyEnter","handleToBrt","featuresFormClose","set","AppRouter","BugReportFormRoute","brt","serviceType","cardLabel","cardDescription","ServiceType","InformationalService","bugReportTool","informationalService","transactionalServices","getActiveTrackingId","onKeyDown","height","x","y","rx","transform","feedbackContainer","backgroundStyle","welcomeMessage","customStyle","displayCloseButton","WidgetLocation","MovementName","LeftMovementName","TopMovementName","RollOutStatusName","_hasWidgetMoved","_rollOutStatus","window","sessionStorage","getItem","left","top","rollStatus","_left","JSON","parse","_top","hasWidgetMoved","removeItem","setItem","toString","rollOutStatus","FloatingActionButton","isMobile","isBRTOnly","floatingButtonState","FloatingButtonState","Initial","hasPositionChanged","widgetLocation","gapSpace","handleFloatingButtonEnter","Utils.unsubscribeAll","rollOutSubscription","Enter","handleFloatingButtonLeave","Leave","positionReset","applyDraggableButton","handleRollout","dragSubscription","mouseUpSubscription","iosTouchForceSubscription","orientationChangeSubscription","disconnectedCallback","handleScroll","handleOrientation","buttonContainer","removeAttribute","easeInSine","t","_c","c","cos","PI","cleanUp$","interval","pipe","tap","take","switchMap","subscribe","handleSentimentsWithinViewPort","maxValue","getClientSize","clientWidth","documentElement","innerHeight","clientHeight","leftValue","topValue","leftGap","middle","isLeftMove","endPosition","options","passive","mousemove$","fromEvent","touches","mouseup$","mousedown$","rect","target","getBoundingClientRect","offsetX","clientX","offsetY","clientY","debounceTime","changedTouches","Utils.createTween","drag$","startEvent","moveEvent","takeUntil","subscribeOn","animationFrameScheduler","SnowplowService","customTrackEvent","category","action","renderText","widgetLabel","getRootPosition","changed","events","onMouseEnter","onMouseLeave","onfocus","onblur","hasEntered","styles","buttonAriaLabel","exit","ModernFeedback","feedbackCancel","displayedOptions","feedbackSubmit","questionSegment","segment","hasOther","QuestionSection","currentStep","validateStatus","questionComplete","moveToNextStep","clearFormStatus","handleSkip","currentQuestions","listOfQuestions","wizardComplete","renderQuestion","submitButtonStyles","Host","SurveyPopup","ctsgUrl","surveyActionComplete","surveyIds","pickedSurvey","navUrl","surveyId","sentimentsId","open","renderBody","thankYouMessage","bodyText","isFeedbackSubmitted","cancelButtonStyle","popupTitle","hidden","TabbedWidget","collapsed","handleClick","tabButtonClick","renderWidgetLabel","transactionalServiceType","TransactionalServiceType","ApplicationOrRenewal","Payment","BookingsOrAppointments","getStyles","textMessage","translateY","includes","TabDesign","transformOrigin","TabDesignWithSmiley","getFaceIcon","margin","renderImage","renderButton","tabindex","bind","renderIcon","colorClass","points","display","renderCollapsedButton","rootStyles","ThankYou","displayComplete","renderCustomMessage","message","thankYouMessageBad","thankYouMessageGood"],"sources":["src/components/bug-report-form/bug-report-form.tsx","src/components/rating-ces/rating-ces.tsx","src/components/connection-error/connection-error.tsx","src/components/features-form/features-form.tsx","src/services/WidgetLocation.ts","src/components/floating-action-button/floating-action-button.tsx","src/components/modern-feedback/modern-feedback.tsx","src/components/question-section/question-section.tsx","src/components/survey-popup/survey-popup.tsx","src/components/tabbed-widget/tabbed-widget.tsx","src/components/thank-you/thank-you.tsx"],"sourcesContent":["import {\n  Component,\n  ComponentWillLoad,\n  Event,\n  EventEmitter,\n  h,\n  Listen,\n  Prop,\n  State,\n} from '@stencil/core';\n\nimport { createFocusTrap } from 'focus-trap';\n\nimport { Appearance } from '@entities/Appearance';\nimport { Design } from '@entities/Design';\nimport { DynamicFormValue } from '@entities/DynamicFormValue';\nimport { ValidateStatus } from '@entities/FieldPayload';\nimport { BRTQuestion } from '@entities/Question';\nimport { QuestionResponse } from '@entities/QuestionResponse';\nimport { WidgetPosition } from '@entities/WidgetPosition';\nimport { QuestionType } from '@entities/QuestionType';\n\n@Component({\n  tag: 'wog-bug-report-form',\n})\nexport class BugReportForm implements ComponentWillLoad {\n  @Prop() questions: BRTQuestion[];\n  @Prop() position: WidgetPosition;\n  @Prop() design: Design;\n  @Prop() themeColor: string;\n  @Prop() appearance: Appearance;\n  @State() isValid = false;\n  @State() registry: Record<string, QuestionResponse> = {};\n  @State() requiredQuestions: string[] = [];\n  @State() preparedQuestions: BRTQuestion[] = [];\n  @State() responses: QuestionResponse[];\n  @Event() bugReportFormCancel: EventEmitter;\n  @Event() bugReportFormSubmit: EventEmitter;\n  @Event() bugReportFormEntry: EventEmitter;\n\n  private bugReportFormContainer: HTMLDivElement;\n  private trap = createFocusTrap('', {});\n\n  @Listen('keydown', { target: 'body' })\n  handleKeyDown(ev: KeyboardEvent) {\n    if (ev.key === 'Escape') {\n      ev.preventDefault();\n      this.handleCancel();\n    }\n  }\n\n  componentWillLoad(): Promise<void> | void {\n    this.preparedQuestions = this.questions.sort((a, b) => a.index - b.index);\n    \n    if(!this.preparedQuestions.filter(q => q.questionType === QuestionType.DefaultAcknowledgeQuestion).length){\n      this.preparedQuestions.push({\n        id: Math.floor((Math.random() * 9999)),\n        index: this.questions.length,\n        isRequired: true,\n        label: \"I confirm the details above are accurate and used only to resolve issues.\",\n        questionId: 'acknowledge-question',\n        questionType: QuestionType.DefaultAcknowledgeQuestion,\n      })\n    } \n    const { registry, requiredQuestions } = this.getRegistry(this.preparedQuestions);\n    this.registry = registry;\n    this.requiredQuestions = requiredQuestions;\n  }\n\n  componentDidLoad() {\n    this.trap = createFocusTrap(this.bugReportFormContainer, {\n      allowOutsideClick: true,\n      clickOutsideDeactivates: true,\n      escapeDeactivates: false,\n      initialFocus: this.bugReportFormContainer,\n      fallbackFocus: this.bugReportFormContainer,\n      onPostActivate: () => {\n        this.trapDeactivate();\n        document.body.focus();\n      },\n    });\n    this.trapActivate();\n\n    // Snowplow event should fire the moment the user sees the bug report form page.\n    this.bugReportFormEntry.emit();\n  }\n\n  private trapActivate = () => {\n    if (!this.trap.active) {\n      this.trap.activate();\n    }\n  };\n\n  private trapDeactivate = () => {\n    if (this.trap.active) {\n      this.trap.deactivate();\n    }\n  };\n\n  private getRegistry(questions: BRTQuestion[]) {\n    const registry = {};\n    let requiredQuestions: string[] = [];\n    for (const question of questions) {\n      const { index, questionId, questionType, isRequired, label } = question;\n      registry[questionId] = {\n        index,\n        questionId,\n        label,\n        questionType,\n        isRequired,\n        isValid: ValidateStatus.None,\n        value: null,\n      };\n      requiredQuestions = isRequired ? [...requiredQuestions, questionId] : requiredQuestions;\n    }\n    return {\n      registry,\n      requiredQuestions,\n    };\n  }\n\n  private handleCancel = () => {\n    this.bugReportFormCancel.emit();\n  };\n\n  private handleValidStatusChange = (event: CustomEvent<DynamicFormValue>) => {\n    const { status, responses } = event.detail;\n    this.responses = responses.filter(r => r.questionType !== QuestionType.DefaultAcknowledgeQuestion);\n    this.isValid = status;\n  };\n\n  private handleSubmit = (event: Event): void => {\n    event.preventDefault();\n    if (this.isValid) {\n      this.trapDeactivate();\n      const values = this.responses.map(({ index, questionId, label, questionType, value }) => ({\n        questionNumber: index,\n        questionId,\n        label,\n        questionType,\n        response: value,\n      }));\n      this.bugReportFormSubmit.emit({ values });\n    }\n  };\n\n  render() {\n    const rootClass = {\n      'wog--tab-view-container': true,\n      'wog--bug-report-form': true,\n      'wog--flex': true,\n      'wog--flex-col': true,\n      'wog--modern-feedback-custom': true,\n      'wog--mobile-bug-report-form': true,\n      'wog--position-left-side': this.position === WidgetPosition.MiddleLeft,\n      'wog--position-right-side': this.position === WidgetPosition.MiddleRight,\n      'wog--position-bottom-left': this.position === WidgetPosition.BottomLeft,\n      'wog--position-bottom-right': this.position === WidgetPosition.BottomRight,\n    };\n\n    const submitButtonCx = {\n      'wog--button': true,\n      'wog--float-right': true,\n      'wog--cursor-pointer': this.isValid,\n      'wog--opacity-50': !this.isValid,\n      'wog--cursor-not-allowed': !this.isValid,\n    };\n\n    const backgroundStyles = {\n      backgroundColor: this.design !== Design.SmileyFace ? this.themeColor : '#333333',\n    };\n    const textStyles = {\n      color: this.appearance === Appearance.Light ? 'white' : '#333333',\n      fontWeight: 'bold',\n    };\n    const formStyles = {\n      width: 'inherit',\n      minWidth: 'auto',\n      minHeight: '40px',\n    };\n\n    return (\n      <div\n        class={rootClass}\n        ref={el => (this.bugReportFormContainer = el as HTMLDivElement)}\n        tabIndex={0}\n        role=\"group\"\n        aria-roledescription=\"Bug Report Form popup\"\n        aria-labelledby=\"wogBugReportFormHeading\">\n        <wog-close-button\n          isWhite={this.appearance === Appearance.Light}\n          onClose={this.handleCancel}\n        />\n        <div\n          class=\"wog--flex wog--items-center wog--justify-center wog--p-4\"\n          tabIndex={0}\n          aria-label=\"Report an issue\"\n          style={backgroundStyles}>\n          <h3\n            id=\"wogBugReportFormHeading\"\n            class=\"wog--text-foundation wog--base-title wog--text-lg\"\n            style={textStyles}>\n            Report an issue\n          </h3>\n        </div>\n        <form\n          novalidate\n          aria-label=\"Add a report issue\"\n          name=\"wogSentimentsReportForm\"\n          class=\"wog--flex wog--h-full wog--flex-col wog--justify-between\"\n          style={formStyles} \n          onSubmit={(e) => e.preventDefault()}>\n          <div class=\"wog--overflow-y-auto wog--p-4 wog--px-4 wog--text-left\">\n            <wog-dynamic-form\n              onValidStatusChange={this.handleValidStatusChange}\n              questions={this.preparedQuestions}\n              registry={this.registry}\n              requiredQuestions={this.requiredQuestions}\n            />\n          </div>\n\n          <div class=\"wog--px-4 wog--py-2\">\n            <button\n              tabIndex={0}\n              type=\"submit\"\n              id=\"wogSubmitForm\"\n              disabled={!this.isValid}\n              style={{ ...backgroundStyles, ...textStyles }}\n              class={submitButtonCx}\n              onClick={this.handleSubmit}>\n              SUBMIT\n            </button>\n          </div>\n        </form>\n      </div>\n    );\n  }\n}\n","import { Component, Event, EventEmitter, h, State } from '@stencil/core';\n\nimport { createFocusTrap } from 'focus-trap';\n\nimport { Configuration } from '@entities/Configuration';\nimport { Design } from '@entities/Design';\nimport { FieldPayload } from '@entities/FieldPayload';\nimport { RatingScaleDesign } from '@entities/RatingScaleDesign';\nimport { WidgetPosition } from '@entities/WidgetPosition';\nimport appStore from '@stores/app.store';\n\nenum SatisfactionState {\n  Rating,\n  Responded,\n}\n\n@Component({\n  tag: 'wog-ces-rating',\n})\nexport class RatingCES {\n  @State() ratedValue: number;\n  @State() satisfactionState: SatisfactionState = SatisfactionState.Rating;\n  @State() isFeedbackButtonActive = false;\n  @Event() ratingClose: EventEmitter<void>;\n  @Event() ratingCESSubmit: EventEmitter<{ value: number }>;\n  @Event() ratingSubmitAnimationComplete: EventEmitter;\n\n  private ratingContainer: HTMLDivElement;\n  private ratingDummyContainer: HTMLDivElement;\n  private trap = createFocusTrap('', {});\n  private cesQuestion: string = 'How easy was it to complete your transaction?';\n\n  componentDidLoad() {\n    setTimeout(() => {\n      this.isFeedbackButtonActive = true;\n      this.trap = createFocusTrap(this.ratingContainer, {\n        allowOutsideClick: true,\n        clickOutsideDeactivates: true,\n        escapeDeactivates: false,\n        initialFocus: this.ratingDummyContainer,\n        onPostActivate: () => {\n          this.trapDeactivate();\n          document.body.focus();\n        },\n      });\n      this.trapActivate();\n    }, 300);\n  }\n\n  private trapActivate = () => {\n    if (!this.trap.active) {\n      this.trap.activate();\n    }\n  };\n\n  private trapDeactivate = () => {\n    if (this.trap.active) {\n      this.trap.deactivate();\n    }\n  };\n\n  private onFeedbackSubmit = (event: CustomEvent<FieldPayload>) => {\n    this.trapDeactivate();\n    this.satisfactionState = SatisfactionState.Responded;\n    const { values } = event.detail;\n    this.ratedValue = parseInt(values[0]);\n    this.ratingCESSubmit.emit({ value: this.ratedValue });\n    this.ratingSubmitAnimationComplete.emit();\n  };\n\n  private onRatingClose = () => {\n    this.ratingClose.emit();\n  };\n\n  private renderSvg() {\n    return (\n      <svg\n        fill=\"none\"\n        class=\"wog--h-12 wog--w-12\"\n        viewBox=\"0 0 64 64\"\n        xmlns=\"http://www.w3.org/2000/svg\">\n        <path\n          clip-rule=\"evenodd\"\n          d=\"m32 64c17.6731 0 32-14.3269 32-32s-14.3269-32-32-32-32 14.3269-32 32 14.3269 32 32 32z\"\n          fill=\"#333\"\n          fill-rule=\"evenodd\"\n        />\n        <path\n          d=\"m55 32c0 12.6829-10.3171 23-23 23s-23-10.3171-23-23 10.3171-23 23-23 23 10.3171 23 23\"\n          fill=\"#fddc67\"\n        />\n        <g fill=\"#333\">\n          <path d=\"m32.0001 45.3243c-5.0397 0-10.0104-2.002-13.8075-6.0062-.6214-.6904-.6214-1.726 0-2.4164.6213-.6904 1.6569-.6904 2.2782 0 6.3515 6.6277 16.7072 6.6967 23.0587 0 .6213-.6904 1.6569-.6904 2.2782 0 .6214.6904.6214 1.726 0 2.4164-3.7971 4.0042-8.8368 6.0062-13.8076 6.0062\" />\n          <path d=\"m22.6102 30.5502c-1.6569 0-2.9686-1.1736-2.9686-2.5544v-1.7259c0-1.4498 1.3117-2.5544 2.9686-2.5544s2.9687 1.1736 2.9687 2.5544v1.7259c0 1.3808-1.3118 2.5544-2.9687 2.5544\" />\n          <path d=\"m41.3895 30.5502c-1.6569 0-2.9686-1.1736-2.9686-2.5544v-1.7259c0-1.4498 1.3117-2.5544 2.9686-2.5544s2.9687 1.1736 2.9687 2.5544v1.7259c0 1.3808-1.3808 2.5544-2.9687 2.5544\" />\n        </g>\n      </svg>\n    );\n  }\n\n  private renderRatingField(config: Configuration) {\n    if (config.ratingScaleDesign === RatingScaleDesign.Numerical) {\n      return (\n        <wog-linear-scale-field\n          name={'stranded-linear-scale'}\n          themeColor={config.themeColor}\n          appearance={config.appearance}\n          highScale={6}\n          lowScale={1}\n          isDisabled={!this.isFeedbackButtonActive}\n          onValueSubmit={this.onFeedbackSubmit}\n          customTabIndex={0}\n        />\n      );\n    }\n\n    if (config.ratingScaleDesign === RatingScaleDesign.Emoji) {\n      return (\n        <wog-emoji-rating-scale-field\n          name={'stranded-linear-scale'}\n          themeColor={config.themeColor}\n          appearance={config.appearance}\n          isDisabled={!this.isFeedbackButtonActive}\n          onValueSubmit={this.onFeedbackSubmit}\n          customTabIndex={0}\n        />\n      );\n    }\n\n    if (config.ratingScaleDesign === RatingScaleDesign.Star) {\n      return (\n        <wog-star-rating-scale-field\n          name={'stranded-linear-scale'}\n          themeColor={config.themeColor}\n          appearance={config.appearance}\n          highScale={6}\n          lowScale={1}\n          isDisabled={!this.isFeedbackButtonActive}\n          onValueSubmit={this.onFeedbackSubmit}\n          customTabIndex={0}\n        />\n      );\n    }\n  }\n\n  private renderConditionalView(\n    viewState: SatisfactionState,\n    config: Configuration,\n    ratingQuestion: string,\n  ) {\n    if (viewState === SatisfactionState.Rating) {\n      const containerClasses = {\n        'wog--box-border': true,\n        'wog--w-full': true,\n        'wog--px-2': true,\n      };\n\n      const ratingFieldClasses = {\n        'wog--px-2':\n          config.ratingScaleDesign === RatingScaleDesign.Emoji ||\n          config.ratingScaleDesign === RatingScaleDesign.Star,\n        'wog--px-4': config.ratingScaleDesign === RatingScaleDesign.Numerical,\n      };\n\n      return (\n        <div\n          class={containerClasses}\n          tabIndex={0}\n          ref={el => (this.ratingContainer = el as HTMLDivElement)}\n          role=\"group\">\n          <wog-close-button onClose={this.onRatingClose} customAriaLabel={'Close rating popup'} />\n          <div\n            tabIndex={0}\n            ref={el => (this.ratingDummyContainer = el as HTMLDivElement)}\n            role=\"group\"\n            aria-roledescription=\"Sentiments widget popup\"\n            aria-labelledby=\"rating-heading\"></div>\n          <h4\n            id={'rating-heading'}\n            class=\"wog--text-foundation wog--base-title wog--satisfaction-animation wog--text-center wog--text-sm wog--text-theme-black\"\n            aria-label=\"How easy was it to find what you need?\">\n            {ratingQuestion}\n          </h4>\n          <div class={ratingFieldClasses}>{this.renderRatingField(config)}</div>\n        </div>\n      );\n    }\n    if (config.design === Design.SmileyFace) {\n      return (\n        <div class=\"wog--flex wog--items-center wog--justify-center wog--py-6\" role=\"alert\">\n          {this.renderSvg()}\n          <h3 class=\"wog--text-foundation wog--base-title wog--m-0 wog--ml-3 wog--text-gray-800\">\n            Thank you! Tell us more.\n          </h3>\n        </div>\n      );\n    }\n    return (\n      <div role=\"alert\">\n        <h3 class=\"wog--text-foundation  wog--base-title wog--text-center wog--text-gray-800\">\n          Thank you! Tell us more.\n        </h3>\n      </div>\n    );\n  }\n\n  render() {\n    const configuration = appStore.get('configuration');\n\n    const elementClasses = {\n      'wog--tab-view-container': true,\n      'wog--flex': true,\n      'wog--flex-col': true,\n      'wog--items-center': true,\n      'wog--justify-center': true,\n      'wog--px-6': true,\n      'wog--py-4': true,\n      'wog--rating-custom': true,\n      'wog--mobile-full-position': true,\n      'wog--position-left-side': configuration.position === WidgetPosition.MiddleLeft,\n      'wog--position-right-side': configuration.position === WidgetPosition.MiddleRight,\n      'wog--position-bottom-left': configuration.position === WidgetPosition.BottomLeft,\n      'wog--position-bottom-right': configuration.position === WidgetPosition.BottomRight,\n    };\n\n    return (\n      <div class={elementClasses}>\n        {this.renderConditionalView(this.satisfactionState, configuration, this.cesQuestion)}\n      </div>\n    );\n  }\n}\n","import { Component, Event, EventEmitter, h, Prop, State } from '@stencil/core';\n\nimport { Appearance } from '@entities/Appearance';\nimport { Design } from '@entities/Design';\nimport { WidgetPosition } from '@entities/WidgetPosition';\n\n@Component({\n  tag: 'wog-connection-error',\n})\nexport class ConnectionError {\n  @Prop() position: WidgetPosition;\n  @Prop() design: Design;\n  @Prop() themeColor: string;\n  @Prop() appearance: Appearance;\n  @Prop() trackingId: string;\n  @State() isLoading = false;\n  @Event() connectWindowClose: EventEmitter<void>;\n  @Event() fetchData: EventEmitter<{ trackingId: string }>;\n\n  private handleRatingClose = () => {\n    this.connectWindowClose.emit();\n  };\n\n  private handleTryAgain = () => {\n    this.isLoading = true;\n    this.fetchData.emit({ trackingId: this.trackingId });\n    setTimeout(() => {\n      this.isLoading = false;\n    }, 5000);\n  };\n\n  render() {\n    const elementClasses = {\n      'wog--tab-view-container': true,\n      'wog--flex': true,\n      'wog--flex-col': true,\n      'wog--items-center': true,\n      'wog--justify-center': true,\n      'wog--px-6': true,\n      'wog--py-4': true,\n      'wog--connection-error': true,\n      'wog--mobile-full-position': true,\n      'wog--position-left-side': this.position === WidgetPosition.MiddleLeft,\n      'wog--position-right-side': this.position === WidgetPosition.MiddleRight,\n      'wog--position-bottom-left': this.position === WidgetPosition.BottomLeft,\n      'wog--position-bottom-right': this.position === WidgetPosition.BottomRight,\n    };\n    const submitButtonStyle = {\n      'wog--button': true,\n      'wog--inline-flex': true,\n      'wog--items-center': true,\n      'wog--opacity-50': this.isLoading,\n      'wog--cursor-pointer': !this.isLoading,\n      'wog--cursor-not-allowed': this.isLoading,\n    };\n    const backgroundStyles = {\n      backgroundColor: this.design !== Design.SmileyFace ? this.themeColor : '#333333',\n    };\n    const textStyles = {\n      color: this.appearance === Appearance.Light ? 'white' : '#333333',\n    };\n    return (\n      <div class={elementClasses}>\n        <div class=\"wog--w-full wog--px-4\">\n          <wog-close-button onClose={() => this.handleRatingClose()} />\n          <div class=\"wog--flex wog--items-center wog--justify-center\">\n            <svg\n              viewBox=\"0 0 20 20\"\n              fill=\"currentColor\"\n              class=\"wog--h-12 wog--w-12 wog--text-theme-black\">\n              <path\n                fill-rule=\"evenodd\"\n                d=\"M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z\"\n                clip-rule=\"evenodd\"\n              />\n            </svg>\n          </div>\n          <h3 class=\"wog--text-foundation wog--base-title wog--satisfaction-animation wog--text-center wog--text-theme-black\">\n            Sorry, something went wrong.\n          </h3>\n          <p class=\"wog--text-foundation wog--base-title wog--mb-2 wog--text-center wog--font-normal wog--text-theme-black\">\n            Please check your connection and try again.\n          </p>\n          <div class=\"wog--flex wog--items-center wog--justify-center\">\n            <button\n              type=\"button\"\n              class={submitButtonStyle}\n              style={{ ...backgroundStyles, ...textStyles }}\n              disabled={this.isLoading}\n              onClick={this.handleTryAgain}>\n              {this.isLoading && (\n                <svg\n                  class=\"wog--animate-spin wog--h-5 wog--w-5 wog--text-current\"\n                  viewBox=\"0 0 24 24\"\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  fill=\"none\">\n                  <circle\n                    class=\"wog--opacity-25\"\n                    cx=\"12\"\n                    cy=\"12\"\n                    r=\"10\"\n                    stroke=\"currentColor\"\n                    stroke-width=\"4\"\n                  />\n                  <path\n                    class=\"wog--opacity-75\"\n                    fill=\"currentColor\"\n                